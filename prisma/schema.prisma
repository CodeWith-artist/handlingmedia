generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

//user////////////////////////////////////////////
enum Role {
  USER
  ADMIN
  MARKETING
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String?
  role           Role      @default(USER)
  emailVerified  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  suspended     Boolean       @default(false)
  sessions       Session[]
  posts    Post[] 
  invites       InviteToken[]
  @@index([email])
}

model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  role      Role      @default(USER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique // hashed refresh token stored here
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

//user////////////////////////////////////////////


enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}



model Post {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  excerpt         String?     @db.Text
  content         String      @db.LongText
  coverImage      String?     // URL / path
  status          PostStatus  @default(DRAFT)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Relations
  authorId        String
  author          User        @relation(fields: [authorId], references: [id])
  categories      CategoryOnPost[]
  tags            TagOnPost[]

  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([slug])
  @@index([authorId])
  @@index([status])
}

model Category {
  id        String           @id @default(cuid())
  name      String           @unique
  slug      String           @unique
  posts     CategoryOnPost[]
  createdAt DateTime         @default(now())
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  posts     TagOnPost[]
  createdAt DateTime     @default(now())
}

model CategoryOnPost {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model TagOnPost {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}


//form 

// prisma/schema.prisma

model Lead {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String
  service   String
  website   String?
  message   String   @db.Text
  source    String?
  status    LeadStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}



















































